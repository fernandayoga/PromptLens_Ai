# OpenRouter API Key (required)
# Get your key at https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Model (optional - defaults to google/gemini-2.0-flash-exp:free)
# Free vision models: google/gemini-2.0-flash-exp:free, meta-llama/llama-3.2-11b-vision-instruct:free
# Paid models: google/gemini-pro-vision, openai/gpt-4-vision-preview, anthropic/claude-3-opus
VITE_OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# Site info for OpenRouter headers (optional)
VITE_SITE_URL=https://your-domain.com
VITE_SITE_NAME=PromptLens AI