# OpenRouter API Key (required for backend)
# Get your key at https://openrouter.ai/keys
# This is used by the Express server (server/index.js) — never exposed to the browser.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Model (optional - defaults to google/gemini-2.0-flash-exp:free)
# Used by the client to send in the request.
VITE_OPENROUTER_MODEL=minimax/minimax-m3:free

# Site info for OpenRouter headers (optional)
VITE_SITE_URL=https://your-domain.com
VITE_SITE_NAME=PromptLens AI

# Port for the backend server (optional)
# PORT=3001